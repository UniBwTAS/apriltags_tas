<launch>
  <node pkg="apriltags_tas" exec="apriltag_detector" name="apriltag_detector" output="screen">
    <param name="tags_config_file" value="$(find-pkg-share apriltags_tas)/config/tags.yaml"/>
    <param name="image_topic" value="/camera/image"/>
    <param name="camera_info_topic" value="/camera/camera_info"/>

    <param name="use_test_input_image" value="true"/>
    <param name="test_input_image_path" value="$(find-pkg-share apriltags_tas)/example_images/0001.png"/>
  </node>
</launch>
